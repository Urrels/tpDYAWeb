@startuml Secuencia_CU13_DesbloquearUsuarios
title CU13 — Desbloquear Usuarios
skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam sequenceParticipant {
    BackgroundColor<<Page>> #FCE7F3
    BackgroundColor<<BLL>> #BBF7D0
    BackgroundColor<<DAL>> #FEF08A
    BackgroundColor<<BD>> #DBEAFE
}

actor "Administrador / Webmaster" as ADM
participant "UsuariosBloqueados.aspx" as PAGE <<Page>>
participant "PerfilBLL" as BLL <<BLL>>
participant "IntegridadBLL" as INTEG <<BLL>>
participant "BitacoraBLL" as BITBLL <<BLL>>
participant "UsuarioDAL" as DAL <<DAL>>
participant "BitacoraDAL" as BITDAL <<DAL>>
database "SQL Server" as DB <<BD>>

ADM -> PAGE : ingresa a UsuariosBloqueados.aspx (permiso "Desbloquear usuarios")
activate PAGE
PAGE -> BLL : ListarBloqueadosVisiblesPor(actor)
activate BLL
BLL -> DAL : ListarBloqueados()
activate DAL
DAL -> DB : Leer("USUARIO_LISTAR_BLOQUEADOS")
note right of DB : SP: USUARIO_LISTAR_BLOQUEADOS\n(SELECT ... WHERE BLOQUEADO = 1)
DB --> DAL : filas (usuario + intentos fallidos)
DAL --> BLL : List<BE.USUARIO>
deactivate DAL
BLL -> BLL : filtra los que el actor puede ver\n(el Administrador no ve usuarios webmaster)
BLL --> PAGE : List<BE.USUARIO>
deactivate BLL
PAGE --> ADM : rptBloqueados con la lista (lblSinBloqueados si viene vacía)
deactivate PAGE

ADM -> PAGE : click "Desbloquear" sobre un usuario bloqueado
activate PAGE
PAGE -> BLL : DesbloquearUsuario(usuarioBloqueado, actor)
activate BLL
BLL -> BLL : exige el permiso "Desbloquear usuarios"\ny que el actor pueda actuar sobre el usuario

BLL -> DAL : Desbloquear(usuario)
activate DAL
DAL -> DB : Escribir("USUARIO_DESBLOQUEAR", params)
note right of DB
  SP: USUARIO_DESBLOQUEAR
  UPDATE USUARIO SET BLOQUEADO = 0, INTENTOS_FALLIDOS = 0
  WHERE USUARIO = @usuario
  El contador de intentos fallidos se resetea en el
  MISMO UPDATE del SP de desbloqueo.
end note
deactivate DAL

BLL -> INTEG : RecalcularUsuario()
note right of INTEG
  Recalcula DVH por fila y DVV por columna
  de la tabla USUARIO vía IntegridadDAL.
end note
BLL -> BITBLL : RegistrarAccion(actor.Usuario, "DESBLOQUEO_USUARIO:" + usuario)
activate BITBLL
BITBLL -> BITDAL : Registrar(actor, accion, criticidad)
BITDAL -> DB : Escribir("BITACORA_INSERTAR", params)
deactivate BITBLL

BLL --> PAGE : (void)
deactivate BLL
PAGE --> ADM : "Usuario '{usuario}' desbloqueado correctamente."\n(recarga rptBloqueados)
deactivate PAGE

alt sin permiso o usuario fuera de su alcance
  BLL --> PAGE : InvalidOperationException ("El usuario no existe.")
  PAGE --> ADM : alerta de error con el mensaje
end

note over BLL
  Un usuario que el actor no puede ver recibe la misma
  respuesta que uno inexistente. El Webmaster desbloquea
  también a los usuarios webmaster; el Administrador no.
end note

@enduml
