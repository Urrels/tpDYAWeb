@startuml DiagramaClases_DAL
title Diagrama de clases - Acceso a Datos (DAL)
top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageFontSize 12
skinparam shadowing false
skinparam ranksep 40
skinparam nodesep 25

package "DAL — Acceso a Datos" as DAL #FEF08A {

  class Acceso <<internal>> {
    +Abrir() / Cerrar()
    +Leer(sp) : DataTable
    +Escribir(sp) : int
    +EscribirConRetorno(sp) : object
    +IniciarTx() / ConfirmarTX() / DeshacerTX()
    +CrearParametro(nombre, valor) : SqlParameter
  }

  class DBInicializador <<static>> {
    +InicializarSiNoExiste()
  }

  class UsuarioDAL {
    +ObtenerPorCredenciales() : USUARIO
    +ObtenerPorNombre() : USUARIO
    +CambiarContrasena() : bool
    +ActualizarDireccion() : bool
    +ListarTodos() : List<USUARIO>
    +InsertarConPerfiles(usuario, hash, direccion, rolIds) : int
    +ActualizarEstado(id, activo)
    +EstaBloqueado(usuario) : bool
    +IncrementarIntentos(usuario) : bool
    +ResetearIntentos(usuario)
    +Desbloquear(usuario)
    +ListarBloqueados() : List<USUARIO>
  }

  class MateriaDAL {
    +Insertar() : int
    +Actualizar() / Eliminar() : bool
    +Listar() : List<MATERIA>
    +ListarTodasConInactivas() : List<MATERIA>
    +ListarPaginado(pagina, tamanio) : PaginaResultado<MATERIA>
    +Obtener(id) : MATERIA
    +ListarCorrelativas() : List<MATERIA>
    +Importar(materias, idPorCodigo, correlativas)
  }

  class AlumnoMateriaDAL {
    +Insertar() / Actualizar() : bool
    +Listar() : List<ALUMNO_MATERIA>
  }

  class InscripcionDAL {
    +InsertarCabecera() : int
    +InsertarDetalle()
    +ExisteEnPeriodo() : bool
    +ObtenerIdPorPeriodo() : int
    +ListarPorUsuario() : List<INSCRIPCION>
  }

  class PeriodoDAL {
    +Listar() : List<PERIODO_ACADEMICO>
    +Insertar() : int
    +Actualizar() : bool
    +ObtenerActual() : PERIODO_ACADEMICO
  }

  class BitacoraDAL {
    +Registrar(usuario, accion, criticidad)
    +Listar() : List<BITACORA>
    +ListarUsuariosDistinct() : List<string>
    +ListarPaginado(...) : PaginaResultado<BITACORA>
  }

  class EventoDAL {
    +Insertar() / Actualizar() / Eliminar() : bool
    +ListarPorUsuario() : List<EVENTO_ACADEMICO>
    +ListarPorMes() : List<EVENTO_ACADEMICO>
  }

  class PerfilDAL {
    +ListarRoles() : List<Rol>
    +ListarPermisosPorRol() : List<Permiso>
    +ListarPermisosDisponibles() : List<Permiso>
    +ListarAsignaciones() : List<(usuarioId, rolId)>
    +ListarRolesDeUsuario(usuarioId) : List<int>
    +AsignarPerfil(usuarioId, rolId)
    +InsertarRol(nombre, padreId) : int
    +RenombrarRol(id, nombre) / EliminarRol(id) / CambiarPadre(id, padreId)
    +GuardarPermisosDeRol(rolId, permisoIds)
    +ReemplazarPerfilesDeUsuario(usuarioId, rolIds)
  }

  class SiembraDAL {
    +ExisteMarcadorSiembra() : bool
    +Aplicar(plan : PlanSiembra) : ResultadoSiembra
  }

  class IdiomaDAL {
    +ListarTodos() / ListarHabilitados() : List<IDIOMA>
    +ObtenerPorId(id) / ObtenerPredeterminado() : IDIOMA
    +Insertar() / Renombrar() / ActualizarEstado() / Eliminar()
    +EstaEnUso(id) : bool
    +RegistrarControl(clave, textoDefault)
    +CargarTraducciones(idiomaId) : Dictionary<string,string>
    +ListarControlesConTraduccion(idiomaId) : List<CONTROL_IDIOMA>
    +GuardarTraduccion(idiomaId, controlId, texto)
    +ObtenerIdiomaDeUsuario(id) : int?
    +ActualizarIdiomaDeUsuario(id, idiomaId)
  }

  class IntegridadDAL {
    +ListarParaIntegridad(tabla) : DataTable
    +ActualizarDVH(tabla, id, dvh)
    +ObtenerDVV(tabla) : Dictionary<string,int>
    +ActualizarDVV(tabla, columna, dvv)
    +ObtenerSnapshot(tabla) : string
    +GuardarSnapshot(tabla, json)
    +EliminarPorId(tabla, id)
    +RestaurarFila{... las 13 tablas}(...)
  }

  UsuarioDAL       --> Acceso
  MateriaDAL       --> Acceso
  AlumnoMateriaDAL --> Acceso
  InscripcionDAL   --> Acceso
  PeriodoDAL       --> Acceso
  BitacoraDAL      --> Acceso
  EventoDAL        --> Acceso
  IntegridadDAL    --> Acceso
  PerfilDAL        --> Acceso
  SiembraDAL       --> Acceso
  IdiomaDAL        --> Acceso

  Acceso           -[hidden]right-> DBInicializador
  DBInicializador  -[hidden]right-> UsuarioDAL
  UsuarioDAL       -[hidden]right-> MateriaDAL
  MateriaDAL       -[hidden]right-> AlumnoMateriaDAL
  AlumnoMateriaDAL -[hidden]right-> InscripcionDAL
  InscripcionDAL   -[hidden]right-> PeriodoDAL
  PeriodoDAL       -[hidden]right-> BitacoraDAL
  BitacoraDAL      -[hidden]right-> EventoDAL
  EventoDAL        -[hidden]right-> IntegridadDAL
}

@enduml
