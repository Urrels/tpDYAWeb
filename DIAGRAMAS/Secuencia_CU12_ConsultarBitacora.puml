@startuml Secuencia_CU12_ConsultarBitacora
title CU12 — Consultar Bitácora
skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam sequenceParticipant {
    BackgroundColor<<Page>> #FCE7F3
    BackgroundColor<<BLL>> #BBF7D0
    BackgroundColor<<DAL>> #FEF08A
    BackgroundColor<<BD>> #DBEAFE
}

actor Administrador as ADM
participant "Bitacora.aspx" as PAGE <<Page>>
participant "BitacoraBLL" as BLL <<BLL>>
participant "BitacoraDAL" as DAL <<DAL>>
database "SQL Server" as DB <<BD>>

ADM -> PAGE : ingresa a Bitacora.aspx
activate PAGE

PAGE -> BLL : ListarUsuariosDistinct()
activate BLL
BLL -> DAL : ListarUsuariosDistinct()
activate DAL
DAL -> DB : Leer("BITACORA_LISTAR_USUARIOS_DISTINCT")
DB --> DAL : usuarios distintos (cifrados)
DAL -> DAL : AESHelper.DesencriptarTexto, quita repetidos y ordena
DAL --> BLL : List<string>
deactivate DAL
BLL --> PAGE : List<string>
deactivate BLL
PAGE --> ADM : llena ddlUsuario ("Todos" + usuarios)

PAGE -> BLL : ListarPaginado(null, null, null, null, 1, 50)
activate BLL
BLL -> DAL : ListarPaginado(usuario, criticidad, fechaDesde, fechaHasta, pagina, tamanio)
activate DAL
DAL -> DB : Leer("BITACORA_LISTAR_FILTRADO", usuario y criticidad cifrados)
note right of DB
  SP: BITACORA_LISTAR_FILTRADO
  Solo compara usuario y criticidad por igualdad
  sobre el texto cifrado; ordena por ID DESC.
end note
DB --> DAL : filas cifradas
DAL -> DAL : descifra, filtra por rango de fechas y pagina en C# (Paginar)
DAL --> BLL : BE.PaginaResultado<BITACORA>
deactivate DAL
BLL --> PAGE : PaginaResultado<BITACORA>
deactivate BLL
PAGE --> ADM : gvBitacora + "Página 1 de N (total registros)"
deactivate PAGE

ADM -> PAGE : elige usuario/criticidad, ingresa fecha desde/hasta, click "Filtrar"
activate PAGE
PAGE -> BLL : ListarPaginado(usuario, criticidad, fechaDesde, fechaHasta+1día, 1, 50)
activate BLL
note right of PAGE
  fechaHasta se corre +1 día antes de llamar
  al BLL porque el rango de fechas se aplica en C#
  con límite exclusivo (Fecha < fechaHasta), ya que la
  fecha está cifrada en la base — Bitacora.aspx.cs
end note
BLL -> DAL : ListarPaginado(usuario, criticidad, fechaDesde, fechaHasta, pagina, tamanio)
activate DAL
DAL -> DB : Leer("BITACORA_LISTAR_FILTRADO", usuario y criticidad cifrados)
DB --> DAL : filas cifradas
DAL -> DAL : descifra, filtra por rango de fechas y pagina en C# (Paginar)
DAL --> BLL : BE.PaginaResultado<BITACORA>
deactivate DAL
BLL --> PAGE : PaginaResultado<BITACORA>
deactivate BLL
PAGE --> ADM : gvBitacora actualizada + paginado recalculado
deactivate PAGE

alt no hay registros que coincidan con los filtros
  ADM -> PAGE : filtra por una combinación sin coincidencias, click "Filtrar"
  activate PAGE
  PAGE -> BLL : ListarPaginado(usuario, criticidad, fechaDesde, fechaHasta, 1, 50)
  activate BLL
  BLL -> DAL : ListarPaginado(usuario, criticidad, fechaDesde, fechaHasta, pagina, tamanio)
  activate DAL
  DAL -> DB : Leer("BITACORA_LISTAR_FILTRADO", usuario y criticidad cifrados)
  DB --> DAL : sin filas que cumplan usuario/criticidad (o ninguna cae en el rango de fechas)
  DAL --> BLL : PaginaResultado<BITACORA> (Filas vacío)
  deactivate DAL
  BLL --> PAGE : PaginaResultado<BITACORA> (Filas vacío, TotalFilas = 0)
  deactivate BLL
  PAGE --> ADM : gvBitacora vacía, Paginador con "Sin registros",\ny botones deshabilitados
  deactivate PAGE
end

@enduml
