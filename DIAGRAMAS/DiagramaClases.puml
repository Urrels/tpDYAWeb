    +AplicarMapaDeCalor()
  }

  class FeriadosBLL {
    +ObtenerFeriados(anio) : List<Feriado>
  }

  class IntegridadBLL {
    +Verificar{las 13 tablas}() : ResultadoIntegridad
    +Recalcular{las 13 tablas}()
    +VerificarTodasLasTablas() : ResultadoIntegridad
    +RecalcularTodasLasTablas()
    +CalcularDVHAlumnoMateria(am) : int
    +RestaurarTodasLasTablas()
  }

  class PerfilBLL {
    +VersionPermisos : int {static}
    +ObtenerArbol() / ObtenerArbolGestionablePor(actor) : List<Rol>
    +ObtenerPermisosEfectivos(usuarioId) : List<string>
    +RefrescarPermisosSiHaceFalta(usuario) : bool
    +CrearRol() / RenombrarRol() / CambiarPadre() / EliminarRol()
    +GuardarPermisosDeRol(rolId, permisoIds, actor)
    +AsignarPerfilesAUsuario(usuarioId, rolIds, actor)
    +CrearUsuario() / ModificarUsuario() / CambiarEstadoUsuario()
    +ResetearContrasena() / DesbloquearUsuario()
    +ListarUsuariosVisiblesPor(actor) : List<USUARIO>
    +ListarUsuariosVisiblesPor(actor, pagina, tamanio) : PaginaResultado<USUARIO>
    +SesionRevocada(usuario) : bool {static}
  }

  class SiembraBLL {
    +CatalogoDePermisos() : List<string> {static}
