  }

  class IdiomaBLL {
    +VersionTraducciones : int {static}
    +ListarTodos() / ListarHabilitados() : List<IDIOMA>
    +Crear() / Renombrar() / ActualizarEstado() / Eliminar()
    +CargarTraducciones(idiomaId) : Dictionary<string,string>
    +GuardarTraducciones(idiomaId, textos, usuario) : int
    +ObtenerIdiomaDeUsuario() / ActualizarIdiomaDeUsuario()
  }

  class FachadaIdioma <<Facade>> {
