@startuml DiagramaClases
top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageFontSize 12
skinparam shadowing false
skinparam ranksep 55
skinparam nodesep 22
scale max 2400 width

' ============================================================
' CAPA BE — Entidades
' ============================================================
package "BE — Entidades" as BE #DBEAFE {

  class USUARIO {
    +Id : int
    +Usuario : string
    +Contrasena : string
    +DireccionEncriptada : string
    +DireccionVisible : string
    +Rol : string
    +IntentosFallidos : int
    --
    +EsAdmin : bool
    +EsWebmaster : bool
  }

  class MATERIA {
    +Id : int
    +Nombre : string
    +Codigo : string
    +Modalidad : string
    +Peso : int
    +Correlativas : List<MATERIA>
  }

  class ALUMNO_MATERIA {
    +Id : int
    +IdUsuario : int
    +IdMateria : int
    +NombreMateria : string
    +CodigoMateria : string
    +Modalidad : string
    +PesoMateria : int
    +Estado : string
    +NotaParcial1, NotaParcial2, NotaRecuperatorio, NotaFinal : decimal?
    +FechaFinal, FechaRecuperatorio : DateTime?
    +DVH : int
    +NivelRiesgo : string
    +MensajeRiesgo : string
    --
    +AproboAmbosPariales : bool
    +NecesitaRecuperatorio : bool
    +TieneFinal : bool
    +TieneRecuperatorio : bool
  }

  class INSCRIPCION {
    +Id : int
    +IdUsuario : int
    +IdPeriodo : int
    +FechaInscripcion : DateTime
    +EtiquetaPeriodo : string
    +Materias : List<MATERIA>
  }

  class PERIODO_ACADEMICO {
    +Id : int
    +Anio : int
    +Cuatrimestre : int
    +Descripcion : string
    +FechaInicio : DateTime?
    +FechaFin : DateTime?
    --
    +Etiqueta : string
  }

  class EVENTO_ACADEMICO {
    +Id : int
    +IdMateria : int
    +NombreMateria : string
    +IdUsuario : int
    +Tipo : string
    +Descripcion : string
    +Fecha : DateTime
    +Peso : int
    +ColorCalor : string
  }

  class BITACORA {
    +Id : int
    +Usuario : string
    +Accion : string
    +Fecha : DateTime
    +Criticidad : string
  }

  class BitacoraPaginaResultado {
    +Filas : List<BITACORA>
    +TotalFilas : int
  }

  class AESHelper <<static>> {
    +Encriptar(texto) : byte[]
    +Desencriptar(datos) : string
  }

  class HashHelper <<static>> {
    +HashSHA256(texto) : string
  }

  class CalculadorDVH <<static>> {
    +Calcular(atributos) : int
    +CalcularVertical(filas, colIdx) : int
  }

  class SessionManager <<singleton>> {
    +getInstane() : SessionManager
    +getUsuario() : USUARIO
    +setUsuario(u) : int
    +cerrarSesion()
  }

  class SessionRegistry <<singleton>> {
    +Instancia : SessionRegistry {static}
    +TieneSesionActiva(usuario) : bool
    +RegistrarSesion(usuario, sessionId)
    +CerrarSesion(usuario)
  }

  MATERIA "0..*" o-- "0..*" MATERIA : correlativas
  INSCRIPCION *-- "0..*" MATERIA
  BitacoraPaginaResultado *-- "0..*" BITACORA : Filas
  SessionManager --> USUARIO

  USUARIO               -[hidden]right-> MATERIA
  MATERIA                -[hidden]right-> ALUMNO_MATERIA
  ALUMNO_MATERIA         -[hidden]right-> INSCRIPCION
  INSCRIPCION            -[hidden]right-> PERIODO_ACADEMICO
  PERIODO_ACADEMICO      -[hidden]right-> EVENTO_ACADEMICO
  EVENTO_ACADEMICO       -[hidden]right-> BITACORA
  BITACORA               -[hidden]right-> BitacoraPaginaResultado
  BitacoraPaginaResultado -[hidden]right-> AESHelper
  AESHelper              -[hidden]right-> HashHelper
  HashHelper             -[hidden]right-> CalculadorDVH
  CalculadorDVH          -[hidden]right-> SessionManager
  SessionManager         -[hidden]right-> SessionRegistry
}

' ============================================================
' CAPA DAL — Acceso a Datos
' ============================================================
package "DAL — Acceso a Datos" as DAL #FEF08A {

  class Acceso <<internal>> {
    +Abrir() / Cerrar()
    +Leer(sp) : DataTable
    +Escribir(sp) : int
    +EscribirConRetorno(sp) : object
    +IniciarTx() / ConfirmarTX() / DeshacerTX()
    +CrearParametro(nombre, valor) : SqlParameter
  }

  class DBInicializador <<static>> {
    +InicializarSiNoExiste()
  }

  class UsuarioDAL {
    +ObtenerPorCredenciales() : USUARIO
    +ObtenerPorNombre() : USUARIO
    +CambiarContrasena() : bool
    +ActualizarDireccion() : bool
    +EstaBloqueado(usuario) : bool
    +IncrementarIntentos(usuario) : bool
    +ResetearIntentos(usuario)
    +Desbloquear(usuario)
    +ListarBloqueados() : List<USUARIO>
  }

  class MateriaDAL {
    +Insertar() : int
    +Actualizar() / Eliminar() : bool
    +Listar() : List<MATERIA>
    +Obtener(id) : MATERIA
    +ListarCorrelativas() : List<MATERIA>
  }

  class AlumnoMateriaDAL {
    +Insertar() / Actualizar() : bool
    +Listar() : List<ALUMNO_MATERIA>
  }

  class InscripcionDAL {
    +InsertarCabecera() : int
    +InsertarDetalle()
    +ExisteEnPeriodo() : bool
    +ObtenerIdPorPeriodo() : int
    +ListarPorUsuario() : List<INSCRIPCION>
  }

  class PeriodoDAL {
    +Listar() : List<PERIODO_ACADEMICO>
    +Insertar() : int
    +Actualizar() : bool
    +ObtenerActual() : PERIODO_ACADEMICO
  }

  class BitacoraDAL {
    +Registrar(usuario, accion, criticidad)
    +Listar() : List<BITACORA>
    +ListarUsuariosDistinct() : List<string>
    +ListarPaginado(...) : BitacoraPaginaResultado
  }

  class EventoDAL {
    +Insertar() / Actualizar() / Eliminar() : bool
    +ListarPorUsuario() : List<EVENTO_ACADEMICO>
    +ListarPorMes() : List<EVENTO_ACADEMICO>
  }

  class IntegridadDAL {
    +ListarParaIntegridad(tabla) : DataTable
    +ActualizarDVH(tabla, id, dvh)
    +ObtenerDVV(tabla) : Dictionary<string,int>
    +ActualizarDVV(tabla, columna, dvv)
    +ObtenerSnapshot(tabla) : string
    +GuardarSnapshot(tabla, json)
    +EliminarPorId(tabla, id)
    +RestaurarFila{Usuario,Materia,PeriodoAcademico,Bitacora,Correlativa,AlumnoMateria,EventoAcademico,Inscripcion,InscripcionDetalle}(...)
  }

  UsuarioDAL       --> Acceso
  MateriaDAL       --> Acceso
  AlumnoMateriaDAL --> Acceso
  InscripcionDAL   --> Acceso
  PeriodoDAL       --> Acceso
  BitacoraDAL      --> Acceso
  EventoDAL        --> Acceso
  IntegridadDAL    --> Acceso

  Acceso           -[hidden]right-> DBInicializador
  DBInicializador  -[hidden]right-> UsuarioDAL
  UsuarioDAL       -[hidden]right-> MateriaDAL
  MateriaDAL       -[hidden]right-> AlumnoMateriaDAL
  AlumnoMateriaDAL -[hidden]right-> InscripcionDAL
  InscripcionDAL   -[hidden]right-> PeriodoDAL
  PeriodoDAL       -[hidden]right-> BitacoraDAL
  BitacoraDAL      -[hidden]right-> EventoDAL
  EventoDAL        -[hidden]right-> IntegridadDAL
}

' ============================================================
' CAPA BLL — Lógica de Negocio
' ============================================================
package "BLL — Lógica de Negocio" as BLL #BBF7D0 {

  enum LoginResultado {
    Exito
    CredencialesInvalidas
    UsuarioBloqueado
    SesionYaActiva
  }

  class LoginBLL {
    +AutenticarUsuario(usuario, contrasena, sessionId) : LoginResultado
  }

  class UsuarioBLL {
    +VerificarContrasena() : bool
    +CambiarContrasena() : bool
    +ObtenerPerfil() : USUARIO
    +ActualizarDireccion() : bool
    +Desbloquear(usuario, admin)
    +ListarBloqueados() : List<USUARIO>
  }

  class MateriaBLL {
    +Insertar() / Actualizar() / Eliminar()
    +Listar() : List<MATERIA>
    +Obtener(id) : MATERIA
    +ListarCorrelativas(idMateria) : List<MATERIA>
  }

  class AlumnoMateriaBLL {
    +Listar(idUsuario) : List<ALUMNO_MATERIA>
    +ActualizarNotas() : bool
    +ListarConRiesgo() : List<ALUMNO_MATERIA>
    +CalcularPromedioPonderado() : (decimal, string)
  }

  class ResultadoIntegridad {
    +EsValido : bool
    +Errores : List<string>
    +IdsUsuariosAfectados : List<int>
  }

  class InscripcionBLL {
    +ObtenerPeriodoActual() : PERIODO_ACADEMICO
    +YaInscripto() : bool
    +ClasificarMaterias() : (disponibles, noDisponibles)
    +Inscribir() : (bool, string, int)
    +ListarHistorial() : List<INSCRIPCION>
  }

  class PeriodoBLL {
    +Listar() : List<PERIODO_ACADEMICO>
    +Insertar() : int
    +Actualizar() : bool
  }

  class BitacoraBLL {
    +RegistrarLogin() / RegistrarLogout()
    +RegistrarAccion(usuario, accion)
    +ListarPaginado(...) : BitacoraPaginaResultado
    +ListarUsuariosDistinct() : List<string>
  }

  class EventoBLL {
    +Insertar() / Actualizar() / Eliminar()
    +ListarPorUsuario() : List<EVENTO_ACADEMICO>
    +ListarPorMes() : List<EVENTO_ACADEMICO>
    +AplicarMapaDeCalor()
  }

  class FeriadosBLL {
    +ObtenerFeriados(anio) : List<Feriado>
  }

  class IntegridadBLL {
    +Verificar{Usuario,Bitacora,Materia,Correlativa,AlumnoMateria,EventoAcademico,PeriodoAcademico,Inscripcion,InscripcionDetalle}() : ResultadoIntegridad
    +Recalcular{Usuario,Bitacora,Materia,Correlativa,AlumnoMateria,EventoAcademico,PeriodoAcademico,Inscripcion,InscripcionDetalle}()
    +VerificarTodasLasTablas() : ResultadoIntegridad
    +RecalcularTodasLasTablas()
    +CalcularDVHAlumnoMateria(am) : int
    +RestaurarTodasLasTablas()
  }

  LoginBLL         ..> LoginResultado
  IntegridadBLL    ..> ResultadoIntegridad

  LoginBLL         --> UsuarioDAL
  LoginBLL         --> BitacoraBLL
  LoginBLL         --> IntegridadBLL
  UsuarioBLL       --> UsuarioDAL
  UsuarioBLL       --> BitacoraBLL
  UsuarioBLL       --> IntegridadBLL
  MateriaBLL       --> MateriaDAL
  MateriaBLL       --> BitacoraBLL
  MateriaBLL       --> IntegridadBLL
  AlumnoMateriaBLL --> AlumnoMateriaDAL
  AlumnoMateriaBLL --> BitacoraBLL
  AlumnoMateriaBLL --> IntegridadBLL
  InscripcionBLL   --> InscripcionDAL
  InscripcionBLL   --> PeriodoDAL
  InscripcionBLL   --> AlumnoMateriaDAL
  InscripcionBLL   --> MateriaDAL
  InscripcionBLL   --> BitacoraBLL
  InscripcionBLL   --> IntegridadBLL
  PeriodoBLL       --> PeriodoDAL
  PeriodoBLL       --> BitacoraBLL
  PeriodoBLL       --> IntegridadBLL
  BitacoraBLL      --> BitacoraDAL
  BitacoraBLL      --> IntegridadBLL
  EventoBLL        --> EventoDAL
  EventoBLL        --> BitacoraBLL
  EventoBLL        --> IntegridadBLL
  IntegridadBLL    --> IntegridadDAL

  LoginBLL         -[hidden]right-> LoginResultado
  LoginResultado   -[hidden]right-> UsuarioBLL
  UsuarioBLL       -[hidden]right-> MateriaBLL
  MateriaBLL       -[hidden]right-> AlumnoMateriaBLL
  AlumnoMateriaBLL -[hidden]right-> ResultadoIntegridad
  ResultadoIntegridad -[hidden]right-> InscripcionBLL
  InscripcionBLL   -[hidden]right-> PeriodoBLL
  PeriodoBLL       -[hidden]right-> BitacoraBLL
  BitacoraBLL      -[hidden]right-> EventoBLL
  EventoBLL        -[hidden]right-> FeriadosBLL
  FeriadosBLL      -[hidden]right-> IntegridadBLL
}

' ============================================================
' CAPA WebForms — Presentación
' ============================================================
package "WebForms — Presentación" as WEB #FCE7F3 {

  class Site <<Master>> {
    +phNavAdmin / phNavAlumno / phNavWebmaster
    +lnkInicio / lblUsuarioNav
    --
    +btnCerrarSesion_Click()
  }

  class Login <<Page>> {
    +LoginBLL
    +IntegridadBLL
  }

  class Menu <<Page>> {
    +AlumnoMateriaBLL
    +EventoBLL
  }

  class Inscripcion <<Page>> {
    +InscripcionBLL
    +PeriodoBLL
  }

  class MisCursadas <<Page>> {
    +AlumnoMateriaBLL
    +EventoBLL
  }

  class Dashboard <<Page>> {
    +AlumnoMateriaBLL
  }

  class Calendario <<Page>> {
    +EventoBLL
    +FeriadosBLL
    +AlumnoMateriaBLL
  }

  class Perfil <<Page>> {
    +UsuarioBLL
  }

  class CambiarContrasena <<Page>> {
    +UsuarioBLL
  }

  class ExportarPDF <<Page>> {
    +AlumnoMateriaBLL
  }

  class Materias <<Page · Admin>> {
    +MateriaBLL
  }

  class Bitacora <<Page · Admin>> {
    +BitacoraBLL
  }

  class UsuariosBloqueados <<Page · Admin>> {
    +UsuarioBLL
  }

  class Integridad <<Page · Webmaster>> {
    +IntegridadBLL
  }

  Login             --> LoginBLL
  Login             --> IntegridadBLL
  Menu              --> AlumnoMateriaBLL
  Menu              --> EventoBLL
  Inscripcion       --> InscripcionBLL
  Inscripcion       --> PeriodoBLL
  MisCursadas       --> AlumnoMateriaBLL
  MisCursadas       --> EventoBLL
  Dashboard         --> AlumnoMateriaBLL
  Calendario        --> EventoBLL
  Calendario        --> FeriadosBLL
  Calendario        --> AlumnoMateriaBLL
  Perfil            --> UsuarioBLL
  CambiarContrasena --> UsuarioBLL
  ExportarPDF       --> AlumnoMateriaBLL
  Materias          --> MateriaBLL
  Bitacora          --> BitacoraBLL
  UsuariosBloqueados --> UsuarioBLL
  Integridad        --> IntegridadBLL

  Site               -[hidden]right-> Login
  Login              -[hidden]right-> Menu
  Menu               -[hidden]right-> Inscripcion
  Inscripcion        -[hidden]right-> MisCursadas
  MisCursadas        -[hidden]right-> Dashboard
  Dashboard          -[hidden]right-> Calendario
  Calendario         -[hidden]right-> Perfil
  Perfil             -[hidden]right-> CambiarContrasena
  CambiarContrasena  -[hidden]right-> ExportarPDF
  ExportarPDF        -[hidden]right-> Materias
  Materias           -[hidden]right-> Bitacora
  Bitacora           -[hidden]right-> UsuariosBloqueados
  UsuariosBloqueados -[hidden]right-> Integridad
}

' ============================================================
' RELACIÓN DIRECTA WEB → BE (fuera del patrón de capas)
' Site.Master.cs cierra sesión llamando directamente a
' BE.SessionRegistry.Instancia.CerrarSesion(), sin pasar por BLL.
' ============================================================
Site --> SessionRegistry

' ============================================================
' FLECHAS OCULTAS — fuerzan layout vertical: WEB → BLL → DAL → BE
' ============================================================
' WEB sobre BLL
Site               -[hidden]down-> LoginBLL
Login              -[hidden]down-> LoginResultado
Menu               -[hidden]down-> UsuarioBLL
Inscripcion        -[hidden]down-> MateriaBLL
MisCursadas        -[hidden]down-> AlumnoMateriaBLL
Dashboard          -[hidden]down-> ResultadoIntegridad
Calendario         -[hidden]down-> InscripcionBLL
Perfil             -[hidden]down-> PeriodoBLL
CambiarContrasena  -[hidden]down-> BitacoraBLL
ExportarPDF        -[hidden]down-> FeriadosBLL
Materias           -[hidden]down-> IntegridadBLL
Bitacora           -[hidden]down-> LoginBLL
UsuariosBloqueados -[hidden]down-> UsuarioBLL
Integridad         -[hidden]down-> IntegridadBLL

' BLL sobre DAL
LoginBLL         -[hidden]down-> UsuarioDAL
LoginResultado   -[hidden]down-> Acceso
UsuarioBLL       -[hidden]down-> MateriaDAL
MateriaBLL       -[hidden]down-> AlumnoMateriaDAL
AlumnoMateriaBLL -[hidden]down-> InscripcionDAL
ResultadoIntegridad -[hidden]down-> PeriodoDAL
InscripcionBLL   -[hidden]down-> BitacoraDAL
PeriodoBLL       -[hidden]down-> EventoDAL
BitacoraBLL      -[hidden]down-> IntegridadDAL
EventoBLL        -[hidden]down-> DBInicializador
FeriadosBLL      -[hidden]down-> UsuarioDAL
IntegridadBLL    -[hidden]down-> IntegridadDAL

' DAL sobre BE
Acceso           -[hidden]down-> USUARIO
DBInicializador  -[hidden]down-> MATERIA
UsuarioDAL       -[hidden]down-> ALUMNO_MATERIA
MateriaDAL       -[hidden]down-> INSCRIPCION
AlumnoMateriaDAL -[hidden]down-> PERIODO_ACADEMICO
InscripcionDAL   -[hidden]down-> EVENTO_ACADEMICO
PeriodoDAL       -[hidden]down-> BITACORA
BitacoraDAL      -[hidden]down-> BitacoraPaginaResultado
EventoDAL        -[hidden]down-> AESHelper
IntegridadDAL    -[hidden]down-> HashHelper

@enduml
